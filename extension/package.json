{
  "name": "tempname-vscode",
  "displayName": "tempName",
  "description": "Developer-first project intelligence for VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Programming Languages", "Other"],
  "activationEvents": ["onCommand:tempname.inspectSymbol"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tempname.inspectSymbol",
        "title": "tempName: Inspect Symbol"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "check": "tsc --noEmit -p ./"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.95.0",
    "typescript": "^5.7.0"
  }
}
