{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run tempName Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/extension/out/**/*.js"
      ],
      "preLaunchTask": "Compile tempName Extension"
    }
  ]
}
